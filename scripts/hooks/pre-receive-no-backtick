#!/usr/bin/env bash
# pre-receive hook — Layer 5 of [[no-backtick-in-commit-messages]].
# Refuses incoming commits whose message contains dangerous tokens.
#
# Install (self-hosted Git server: Gitea, Forgejo, Gitolite, cgit):
#   mkdir -p /path/to/repo.git/wrappers
#   cp scripts/wrappers/dangerous-tokens.sh /path/to/repo.git/wrappers/
#   cp scripts/hooks/pre-receive-no-backtick /path/to/repo.git/hooks/pre-receive
#   chmod +x /path/to/repo.git/hooks/pre-receive
#
# The wrappers directory is REQUIRED, not optional. This hook resolves its
# token list as "$HOOK_DIR/../wrappers/dangerous-tokens.sh", so copying only
# the hook file leaves the library missing, `source` fails under `set -e`, and
# the hook declines EVERY push with "No such file or directory". That was the
# documented install command until it was run and the push was rejected.
#
# GitHub: GitHub does NOT support server-side pre-receive hooks.
# For GitHub, use Layer 6 (CI gate in .github/workflows/) which
# runs the same scan on every PR.
#
# Token list: scripts/wrappers/dangerous-tokens.sh (single source of
# truth shared with Layers 2/3/6/7).

set -euo pipefail

ZERO="0000000000000000000000000000000000000000"

# Resolve through any symlink so the hook works both as a real file installed
# at repo.git/hooks/pre-receive and as a symlink created by
# scripts/install-hooks.sh. This previously used plain `dirname "$0"`, which
# under the symlink install pointed at .git/hooks and could not find the
# library at all. commit-msg-no-backtick has always used readlink -f; the two
# hooks now agree.
HOOK_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=scripts/wrappers/dangerous-tokens.sh
# shellcheck disable=SC1091
source "$HOOK_DIR/../wrappers/dangerous-tokens.sh"

scanned_refs=0
scanned_commits=0
skipped_present=0

while read -r oldrev newrev refname || [[ -n "$newrev" ]]; do
  # Branch/tag deletion or creation of an unborn branch — ignore.
  if [[ "$newrev" == "$ZERO" ]]; then
    continue
  fi

  scanned_refs=$((scanned_refs + 1))

  # List of new commits being introduced by this push.
  if [[ "$oldrev" == "$ZERO" ]]; then
    revs=$(git rev-list "$newrev" --not --all 2>/dev/null || git rev-list "$newrev")
  else
    revs=$(git rev-list "$oldrev..$newrev")
  fi

  # A ref whose revisions are all already present on the server yields an
  # empty list. That is legitimate -- those messages were vetted when they
  # first arrived -- but it is indistinguishable from having examined
  # nothing, so it is counted and reported rather than passing in silence.
  if [[ -z "$revs" ]]; then
    skipped_present=$((skipped_present + 1))
  fi

  for rev in $revs; do
    scanned_commits=$((scanned_commits + 1))
    msg=$(git log -1 --format='%B' "$rev")
    offenders=$(dangerous_present "$msg" || true)
    if [[ -n "$offenders" ]]; then
      short=$(git log -1 --format='%h' "$rev")
      subject=$(git log -1 --format='%s' "$rev")
      cat >&2 <<EOF

================================================================================
PUSH REFUSED by pre-receive hook (Layer 5)
================================================================================
Ref:          $refname
Commit:       $short
Subject:      $subject
Offenders:    $offenders

RFC-0011-c 2026-09-08 lesson: bash POSIX §2.6.3 expands backticks / \$()
inside double-quoted \`git commit -m \"...\"\` BEFORE git sees the message.
4 fix commits were pushed inadvertently that day. This hook prevents the
class of bug at the server boundary — even if every local hook is bypassed.

Token list: scripts/wrappers/dangerous-tokens.sh

Fix:
  1. Drop the offending characters from the commit message.
  2. Or amend the commit: \`git commit --amend -F /tmp/clean-msg.txt\`
     (use single-quoted heredoc, see scripts/wrappers/safe-commit).

[[no-backtick-in-commit-messages]]
================================================================================

EOF
      exit 1
    fi
  done
done

# Report the population that was actually examined. A hook that prints
# nothing on success cannot be told apart from one that examined nothing,
# and every other guard in this framework now states its coverage.
if (( scanned_refs == 0 )); then
  echo "pre-receive: no ref updates to examine" >&2
elif (( scanned_commits == 0 )); then
  echo "pre-receive: ${scanned_refs} ref(s), 0 new commits" \
       "(${skipped_present} already present on this server)" >&2
else
  echo "pre-receive: scanned ${scanned_commits} commit(s)" \
       "across ${scanned_refs} ref(s), no dangerous tokens" >&2
fi

exit 0
